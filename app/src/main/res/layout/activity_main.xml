<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F8">

    <!-- 顶部导航 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#159BCB">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="‹ 返回"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="我的音乐"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 当前路径 -->
    <TextView
        android:id="@+id/txtPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:singleLine="true"
        android:text="/storage/sdcard/mp3/"
        android:textColor="#667085"
        android:textSize="12sp"
        android:ellipsize="middle" />
    <!-- 全局媒体音量控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="音量"
            android:textSize="12sp"
            android:textColor="#667085" />

        <TextView
            android:id="@+id/btnMute"
            android:layout_width="32dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🔊"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <SeekBar
            android:id="@+id/seekVolume"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:max="15"
            android:progress="10" />

        <TextView
            android:id="@+id/txtVolumeValue"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="--%"
            android:textSize="12sp"
            android:textColor="#159BCB" />
    </LinearLayout>
    <!-- 文件列表 -->
    <ListView
        android:id="@+id/listAudio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E9EDF1"
        android:dividerHeight="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:background="#F4F6F8"
        android:cacheColorHint="#00000000"
        android:scrollbars="vertical" />

    <!-- 底部播放器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="#FFFFFF">

        <!-- 当前播放歌曲 -->
        <TextView
            android:id="@+id/txtPlayingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="尚未播放歌曲"
            android:textSize="15sp"
            android:textColor="#202833"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 播放时间 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCurrentTime"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="11sp"
                android:textColor="#89939F" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/txtTotalTime"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:textSize="11sp"
                android:textColor="#89939F" />
        </LinearLayout>



        <!-- 播放控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="上一首"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPlay"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:text="播放"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="下一首"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- 底部状态 -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="准备就绪"
        android:textColor="#89939F"
        android:textSize="11sp"
        android:background="#F4F6F8" />

</LinearLayout>
